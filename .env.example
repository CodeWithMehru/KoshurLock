# ============================================================================
#  Tracepoint - environment template
#  Copy to .env and set LLM_API_KEY to your own free Groq key
#  (https://console.groq.com). Everything else can stay as-is.
#  100% FREE, self-hosted, open-source: Groq LLM + local FastEmbed + Postgres.
# ============================================================================

# ----- LLM: Groq via LiteLLM -----------------------------------------------
LLM_PROVIDER=custom
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_ENDPOINT=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_REPLACE_ME_WITH_YOUR_GROQ_KEY
LLM_TEMPERATURE=0.0
LLM_MAX_COMPLETION_TOKENS=16384
# json_mode is required for Groq. Do NOT use json_schema_mode (cognify aborts).
LLM_INSTRUCTOR_MODE=json_mode

# ----- Groq free-tier rate-limit guards ------------------------------------
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=25
LLM_RATE_LIMIT_INTERVAL=60

# Per-file ingest ceiling (seconds): a file whose add+cognify exceeds this is
# marked failed and the queue moves on. Rate limits do NOT fail a file - it
# waits visibly and retries. Keep this ABOVE 300 (cognee retries LLM calls
# internally for ~240s before surfacing a rate limit); raise for huge files.
INGEST_FILE_TIMEOUT_S=360

# ----- Embeddings: LOCAL FastEmbed (FREE, never OpenAI) --------------------
# EMBEDDING_DIMENSIONS MUST be set (unset -> 3072 -> silent OpenAI fallback).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ----- Storage: FalkorDB (Graph + Vector) + SQLite (Relational) ------------
DB_PROVIDER=sqlite
DB_NAME=cognee_db

VECTOR_DB_PROVIDER=falkor
VECTOR_DB_URL=falkordb
VECTOR_DB_PORT=6379
VECTOR_DB_NAME=koshurlock_holmes

GRAPH_DATABASE_PROVIDER=falkor
GRAPH_DATABASE_URL=falkordb
GRAPH_DATABASE_PORT=6379
GRAPH_DATABASE_NAME=koshurlock_holmes

FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=koshurlock_holmes

# ----- Single-user mode ----------------------------------------------------
ENABLE_BACKEND_ACCESS_CONTROL=false
CACHING=false
TEMPORAL_COGNIFY=false

# ----- Startup / logging ---------------------------------------------------
COGNEE_SKIP_CONNECTION_TEST=true
LOG_LEVEL=INFO

# Do NOT set OPENAI_API_KEY. The backend hard-fails on startup if it is present.
